# Postgres (Supabase): Project Settings → Database
#
# IMPORTANT (Vercel / Prisma): If DATABASE_URL uses the transaction pooler (host contains
# pooler.supabase.com and port 6543), you MUST add ?pgbouncer=true (and keep it on Vercel).
# Without it, Postgres returns 42P05 "prepared statement already exists" and every query fails.
#
# Optional for serverless: add &connection_limit=1 to reduce connection churn.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: "Session" mode on port 5432 (same pooler host). Do NOT put pgbouncer=true on DIRECT_URL.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Your OWN secret for signing login tokens (Express). NOT the Supabase DB password.
# Any long random string is fine (or reuse Supabase Settings → API → JWT signing secret only if you understand it).
JWT_SECRET="use-a-long-random-string-at-least-16-chars"
PORT=3001
ADMIN_SECRET="use-a-secret-only-you-know-for-the-admin-dashboard"

# Required on Vercel for avatars & documents (create a private bucket in Supabase → Storage).
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-server-only-never-in-the-browser"
SUPABASE_STORAGE_BUCKET="apply-once-uploads"
