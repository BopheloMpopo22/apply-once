generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  /// Null when the account only signs in with Supabase Auth (e.g. Google).
  passwordHash      String?
  /// Matches auth.users.id — enables Supabase Dashboard → Authentication users.
  supabaseAuthId    String?  @unique @db.Uuid
  avatarStoragePath String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  profile           Profile?
  careerQuestionnaire CareerQuestionnaire?
  application       ApplicationDraft?
  documents         Document[]
  inboxItems        ProfileInboxItem[]
  chatMessages      ChatMessage[]
}

/// Updates on application progress + optional requests for extra info (essay, docs, etc.).
model ProfileInboxItem {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  body             String
  kind             String
  requiresResponse Boolean   @default(false)
  studentResponse  String?
  respondedAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Saved once — typical SA bursary “profile” fields (expand later).
model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String?
  lastName           String?
  phone              String?
  dateOfBirth        String?
  idNumber           String?
  gender             String?
  citizenship        String?
  disability         Boolean  @default(false)
  disabilityNotes    String?
  homeLanguage       String?
  residentialAddress String?
  postalAddress      String?
  updatedAt          DateTime @updatedAt
}

/// One-per-user career goals questionnaire (application form + profile).
model CareerQuestionnaire {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// JSON: studyChoice1–3, workSector, jobLinkedBursary, careerPriority, etc.
  answers     String    @default("{}")
  skipped     Boolean   @default(false)
  completedAt DateTime?
  /// Cached match totals from last completion (open opportunities only).
  bursaryCount      Int?
  scholarshipCount  Int?
  matchedAt         DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Curated SA bursaries & scholarships we may apply to on behalf of students.
model BursaryOpportunity {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  provider           String
  type               String   // bursary | scholarship
  /// JSON string array of field slugs, or ["all"]
  studyFields        String
  /// JSON string array of work-sector slugs, or ["any"]
  workSectors        String   @default("[\"any\"]")
  offersJobAfterGrad Boolean  @default(false)
  applicationCloses  DateTime
  active             Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, applicationCloses])
  @@index([type])
}

/// Flexible JSON for academics, household, financials, essays — universal application layer.
model ApplicationDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepIndex Int      @default(0)
  /// JSON string (SQLite-friendly).
  payload   String   @default("{}")
  updatedAt DateTime @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  filename    String
  mimeType    String
  size        Int
  storagePath String
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    String   // 'student' | 'admin'
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model VarsityUniversity {
  /// Stable slug, e.g. 'wits', 'uj'
  id             String  @id
  name           String
  shortName      String
  website        String
  logoPath       String
  calculatorType String
  active         Boolean @default(true)

  programmes VarsityProgramme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VarsityProgramme {
  id           String @id
  universityId String
  university   VarsityUniversity @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  faculty      String
  campus       String?
  externalCode String?
  active       Boolean @default(true)

  ruleSets VarsityProgrammeRuleSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, faculty])
  @@index([universityId, name])
}

model VarsityProgrammeRuleSet {
  id           String @id @default(cuid())
  programmeId  String
  programme    VarsityProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  catalogueYear Int
  minAps       Int
  notes        String?

  requirements VarsityProgrammeRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programmeId, catalogueYear])
  @@index([catalogueYear])
}

model VarsityProgrammeRequirement {
  id        String @id @default(cuid())
  ruleSetId String
  ruleSet   VarsityProgrammeRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  /// 'single' | 'anyOf'
  kind      String
  label     String?
  payloadJson String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleSetId])
}
